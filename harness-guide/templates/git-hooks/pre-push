#!/bin/sh
# Git hook: stops a push into main and master.
# git feeds lines to stdin in the form:
#   <local ref> <local commit> <remote ref> <remote commit>
#
# Turn on in a clone:  git config core.hooksPath .githooks
# The file must be executable (chmod +x), otherwise git silently skips it.
# Enable it after the very first push of main: a new repository has to get its
# main branch to the server once.
# This guards against a slip. The real ban is branch protection on the hosting site.

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "A direct push into ${remote_ref#refs/heads/} is not allowed. Open a merge request." >&2
      exit 1
      ;;
  esac
done

exit 0
